    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --success: #16a34a;
            --error: #dc2626;
            --background: #f8fafc;
            --surface: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
        }

        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: var(--background);
            color: var(--text);
            line-height: 1.5;
            margin: 0;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        header {
            background: var(--surface);
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            margin-bottom: 24px;
            text-align: center;
        }

        h1 {
            margin: 0 0 8px 0;
            color: var(--primary-dark);
            font-size: 1.8rem;
        }

        p.subtitle {
            margin: 0;
            color: #64748b;
        }

        .score-board {
            display: flex;
            justify-content: space-around;
            background: var(--primary);
            color: white;
            padding: 12px;
            border-radius: 8px;
            margin-top: 16px;
            font-weight: bold;
        }

        .question-card {
            background: var(--surface);
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 2px 4px rgb(0 0 0 / 0.05);
            margin-bottom: 20px;
            border: 1px solid var(--border);
        }

        .question-title {
            font-weight: 600;
            font-size: 1.1rem;
            margin-bottom: 16px;
        }

        .options-list {
            list-style-type: none;
            padding: 0;
            margin: 0 0 16px 0;
        }

        .option-item {
            padding: 12px 16px;
            border: 1px solid var(--border);
            border-radius: 8px;
            margin-bottom: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .option-item:hover {
            background-color: #f1f5f9;
            border-color: #cbd5e1;
        }

        .option-item.correct {
            background-color: #dcfce7 !important;
            border-color: var(--success) !important;
            color: #166534;
        }

        .option-item.incorrect {
            background-color: #fee2e2 !important;
            border-color: var(--error) !important;
            color: #991b1b;
        }

        input[type="radio"], input[type="checkbox"] {
            accent-color: var(--primary);
        }

        .btn {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn:hover {
            background-color: var(--primary-dark);
        }

        .rationale {
            margin-top: 12px;
            padding: 12px;
            background-color: #f8fafc;
            border-left: 4px solid var(--primary);
            border-radius: 4px;
            font-size: 0.95rem;
            display: none;
        }

        .rationale.visible {
            display: block;
        }
    </style>
</head>
